# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# claude / agent internals — ignore session data but track project config
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.agents/

# typescript
*.tsbuildinfo
next-env.d.ts

# local working notes & scratch — not part of the codebase
/Claude/
/session-history/
/Delete Me/
/HANDOFF-*.md
/test_ad.jpg
outputs/
.codex/
Claude outputs/
